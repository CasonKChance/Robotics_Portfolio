<?xml version="1.0"?>
<robot name="2r_robot_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="properties.xacro"/>
  <xacro:include filename="components.xacro"/>

  <!--Attach base_link to world -->
  <link name="world"/>
  <joint name="joint_world_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base platform -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height / 2.0}"/>
      <geometry>
        <box size="${base_width} ${base_length} ${base_height}"/>
      </geometry>
      <material name="base_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height / 2.0}"/>
      <geometry>
        <box size="${base_width} ${base_length} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia origin_xyz="0 0 ${base_height / 2.0}" mass="${base_mass}" base_width="${base_width}" base_length="${base_length}" base_height="${base_height}"/>
  </link>

  <link name="pedestal_link">
    <visual>
      <origin xyz="0 0 ${base_height + pedestal_height / 2.0}"/>
      <geometry>
        <cylinder length="${pedestal_height}" radius="${pedestal_radius}"/>
      </geometry>
      <material name="base_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height + pedestal_height / 2.0}"/>
      <geometry>
        <cylinder length="${pedestal_height}" radius="${pedestal_radius}"/>
      </geometry>
    </collision>
    <xacro:z_aligned_cylinder_inertia origin_xyz="0 0 ${base_height + pedestal_height / 2.0}" mass="${pedestal_mass}" radius="${pedestal_radius}" length="${pedestal_height}"/>
  </link>
  <joint name="joint_base_pedestal" type="fixed">
    <parent link="base_link"/>
    <child link="pedestal_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Circular shoulder pivot housing is fixed to the pedestal. -->
  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="${shoulder_radius}" length="${shoulder_length}"/>
      </geometry>
      <material name="joint_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="${shoulder_radius}" length="${shoulder_length}"/>
      </geometry>
    </collision>
    <xacro:y_aligned_cylinder_inertia origin_xyz="0 0 0" mass="${shoulder_mass}" radius="${shoulder_radius}" length="${shoulder_length}"/>
  </link>
  <joint name="joint_pedestal_shoulder" type="fixed">
    <parent link="pedestal_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 ${-shoulder_length / 4.0} ${base_height + pedestal_height}"/>
  </joint>

  <!-- Both rotation axes point along +Y, producing motion in the X-Z plane. -->
  <link name="arm_link_1">
    <xacro:arm_segment length="${arm_length}" mass="${arm_mass}"/>
    <!-- Elbow housing, located at the far end of link 1. -->
    <visual>
      <origin xyz="${-arm_length} 0 0" rpy="${-pi / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="${joint_radius}" length="${joint_length}"/>
      </geometry>
      <material name="arm_silver"/>
    </visual>
    <collision>
      <origin xyz="${-arm_length} 0 0" rpy="${-pi / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="${joint_radius}" length="${joint_length}"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint_shoulder_arm1" type="continuous">
    <parent link="shoulder_link"/>
    <child link="arm_link_1"/>
    <origin xyz="0 ${-(shoulder_length + joint_length) / 2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="${joint_effort}" velocity="${joint_velocity}"/>
    <dynamics damping="0.15" friction="0.02"/>
  </joint>

  <link name="arm_link_2">
    <xacro:arm_segment length="${arm_length}" mass="0.6"/>
  </link>
  <joint name="joint_arm1_arm2" type="continuous">
    <parent link="arm_link_1"/>
    <child link="arm_link_2"/>
    <origin xyz="${-arm_length} ${-joint_length} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="${joint_effort}" velocity="${joint_velocity}"/>
    <dynamics damping="0.10" friction="0.02"/>
  </joint>

  <!-- End effector -->
  <link name="end_effector_link">
    <visual>
      <origin xyz="${-end_effector_length / 2.0} 0 0" rpy="0 ${-pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="${end_effector_radius}" length="${end_effector_length}"/>
      </geometry>
      <material name="end_effector_blue"/>
    </visual>
    <collision>
      <origin xyz="${-end_effector_length / 2.0} 0 0" rpy="0 ${-pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="${end_effector_radius}" length="${end_effector_length}"/>
      </geometry>
    </collision>
    <xacro:x_aligned_cylinder_inertia origin_xyz="${-end_effector_length / 2.0} 0 0" mass="${end_effector_mass}" radius="${end_effector_radius}" length="${end_effector_length}"/>
  </link>
  <joint name="joint_arm2_end-effector" type="fixed">
    <parent link="arm_link_2"/>
    <child link="end_effector_link"/>
    <origin xyz="${-arm_length} 0 0" rpy="0 0 0"/>
  </joint>
</robot>
