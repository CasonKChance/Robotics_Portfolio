<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- All dimensions are in meters, masses in kilograms. -->
  <xacro:property name="base_width" value="0.25"/>
  <xacro:property name="base_length" value="0.25"/>
  <xacro:property name="base_height" value="0.05"/>
  <xacro:property name="base_mass" value="1.0"/>

  <xacro:property name="pedestal_height" value="0.6"/>
  <xacro:property name="pedestal_radius" value="0.035"/>
  <xacro:property name="pedestal_mass" value="2.0"/>

  <xacro:property name="shoulder_length" value="0.15"/>
  <xacro:property name="shoulder_radius" value="0.05"/>
  <xacro:property name="shoulder_mass" value="1.0"/>"

  <xacro:property name="arm_length" value="0.3"/>
  <xacro:property name="arm_radius" value="0.025"/>
  <xacro:property name="arm_mass" value="0.8"/>

  <xacro:property name="joint_radius" value="0.05"/>
  <xacro:property name="joint_length" value="0.05"/>

  <xacro:property name="end_effector_length" value="0.05"/>
  <xacro:property name="end_effector_radius" value="0.025"/>
  <xacro:property name="end_effector_mass" value="0.1"/>

  <xacro:property name="joint_effort" value="20.0"/>
  <xacro:property name="joint_velocity" value="1.5"/>

  <material name="base_gray"><color rgba="0.25 0.29 0.33 1"/></material>
  <material name="joint_dark"><color rgba="0.12 0.14 0.18 1"/></material>
  <material name="arm_silver"><color rgba="0.72 0.77 0.81 1"/></material>
  <material name="end_effector_blue"><color rgba="0 0 1 1"/></material>
</robot>
